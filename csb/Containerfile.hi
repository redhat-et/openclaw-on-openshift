# =============================================================================
# OpenClaw CSB — Red Hat Hardened Images variant (comparison build)
# File: csb/Containerfile.hi
#
# EXPERIMENTAL / not wired into CI. Kept alongside csb/Containerfile and
# csb/Containerfile.openclaw for side-by-side comparison, not as a
# replacement. Builds BOTH CSB image variants from one file, entirely on
# Red Hat Hardened Images (the productized successor to Project
# Hummingbird) -- no RHEL/UBI base, no separate base/Containerfile build.
#
# Build context: repo root (.)
# Build commands:
#   podman build -f csb/Containerfile.hi --target runtime-openshell \
#     --build-arg OPENCLAW_EXTENSIONS=openshell \
#     -t ...:csb-hi-latest .
#   podman build -f csb/Containerfile.hi --target runtime-openclaw-only \
#     -t ...:csb-hi-openclaw-only-latest .
#
# Shared builder stage + two runtime targets:
#   builder                — Hardened Images nodejs builder compiles OpenClaw
#   runtime-openshell       — + OpenShell CLI, sandbox user/policy
#                             (equivalent of csb/Containerfile)
#   runtime-openclaw-only   — no OpenShell
#                             (equivalent of csb/Containerfile.openclaw)
#
# Both runtime targets are the same Hardened Image (hi/nodejs) used by the
# builder. It ships SQLite 3.53.4, so unlike csb/Containerfile there is no
# separate Node-runtime binary-swap stage needed to work around OpenClaw's
# plugin-state store rejecting older SQLite versions, and no dependency on
# quay.io/redhat-et/openshell:base-* / base/Containerfile at all.
# =============================================================================

ARG NODE_IMAGE=registry.access.redhat.com/hi/nodejs@sha256:52ea553eff206e75c3dec4ab689c7daa49ec3b81103f2b26e7b82cc7800f61ce

# ---------------------------------------------------------------------------
# Stage 1: Builder — compile OpenClaw from source (shared by both variants)
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS builder

LABEL stage="builder"

USER root
WORKDIR /build

ENV CI=true

RUN dnf install -y \
      git \
      python3 \
      make \
      gcc \
      gcc-c++ && \
    dnf clean all && \
    rm -rf /var/cache/dnf

RUN npm install -g pnpm@11.2.2

# TESTING ONLY: pinned to a v2026.7.2 beta because it's the first tag with
# scripts/lib/docker-plugin-selection.mjs (needed to select the openshell
# extension below). No stable tag has this yet. Switch back to a stable
# OPENCLAW_REF once 2026.7.2 ships.
ARG OPENCLAW_REF=v2026.7.2-beta.7
ARG OPENCLAW_COMMIT=dabe1915362e20c25704af91612a32a8f4c96e83
RUN git clone --depth 1 --branch "${OPENCLAW_REF}" https://github.com/openclaw/openclaw.git . && \
    test "$(git rev-parse HEAD)" = "${OPENCLAW_COMMIT}"

# Extension selection — falls back to pnpm build on older release tags.
# Pass OPENCLAW_EXTENSIONS=openshell at build time for the OpenShell target,
# leave it empty for the OpenClaw-only target (extensions like openshell are
# excluded from the build by default upstream).
ARG OPENCLAW_EXTENSIONS=""
RUN if [ -f scripts/lib/docker-plugin-selection.mjs ]; then \
      node scripts/lib/docker-plugin-selection.mjs extensions "${OPENCLAW_EXTENSIONS}" \
        > /tmp/openclaw-selected-plugin-dirs; \
      touch /tmp/openclaw-plugin-selection-supported; \
      echo "Selected extensions:" && cat /tmp/openclaw-selected-plugin-dirs; \
    elif [ -n "${OPENCLAW_EXTENSIONS}" ]; then \
      echo "ERROR: OPENCLAW_EXTENSIONS='${OPENCLAW_EXTENSIONS}' was requested but scripts/lib/docker-plugin-selection.mjs is not available on this ref" >&2; \
      exit 1; \
    else \
      echo "Extension selection script not available on this ref — all extensions will be built"; \
    fi

RUN pnpm install --frozen-lockfile

# Compile TypeScript → dist/
RUN set -eu; \
    if [ -f /tmp/openclaw-plugin-selection-supported ]; then \
      selected_plugin_dirs="$(cat /tmp/openclaw-selected-plugin-dirs)"; \
      OPENCLAW_INTERNAL_DOCKER_BUILD_PLUGIN_IDS="$selected_plugin_dirs" \
      OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 \
      NODE_OPTIONS="--max-old-space-size=8192" \
      pnpm_config_verify_deps_before_run=false pnpm build:docker; \
    else \
      NODE_OPTIONS="--max-old-space-size=8192" \
      pnpm build; \
    fi
RUN pnpm_config_verify_deps_before_run=false pnpm ui:build || pnpm ui:build

# Reconcile node_modules to production dependencies from the committed lockfile.
# Offline mode prevents this reduction step from introducing network drift.
RUN pnpm install --prod --offline --frozen-lockfile

# The production install recreates workspace links. Materialize them only after
# dependency selection so deleting packages/ cannot leave dangling runtime
# dependencies such as @openclaw/ai.
RUN find node_modules -type l | while IFS= read -r link; do \
      target="$(readlink -f "$link")"; \
      case "$target" in \
        /build/packages/*|/build/extensions/*) \
          test -e "$target"; \
          rm "$link" && cp -a "$target" "$link" && \
          echo "Resolved workspace link: $link" \
          ;; \
      esac; \
    done; \
    ! find node_modules -type l | while IFS= read -r link; do \
      target="$(readlink -f "$link")"; \
      case "$target" in \
        /build/packages/*|/build/extensions/*) echo "$link"; break ;; \
      esac; \
    done | grep -q .

# Strip non-runtime artifacts from the selected production dependencies.
RUN set -eu; \
    find node_modules -maxdepth 4 \( \
        -name "*.md"        -o -name "*.MD"      \
        -o -name "*.txt"    -o -name "*.map"      \
        -o -name "CHANGELOG*" -o -name "LICENCE*" \
        -o -name "LICENSE"  -o -name "AUTHORS"    \
        -o -name ".travis.yml" -o -name ".eslintrc*" \
        -o -name "Makefile" -o -name "*.sh"       \
    \) -delete; \
    find node_modules -maxdepth 5 -type d \( \
        -name "__tests__" -o -name "test"  \
        -o -name "tests"  -o -name "spec"  \
        -o -name ".github" -o -name ".circleci" \
        -o -name "example" -o -name "examples"  \
    \) -exec rm -rf {} + 2>/dev/null || true; \
    find node_modules -maxdepth 6 -name "*.ts" ! -name "*.d.ts" -delete; \
    find node_modules -maxdepth 6 -name "*.js.map" -delete; \
    ARCH=$(uname -m); \
    if [ "$ARCH" = "x86_64" ]; then \
      find node_modules -maxdepth 6 \( \
          -name "*darwin*" -o -name "*win32*" \
          -o -name "*freebsd*" -o -name "*linux-arm*" \
      \) -name "*.node" -delete 2>/dev/null || true; \
    else \
      find node_modules -maxdepth 6 \( \
          -name "*darwin*" -o -name "*win32*" \
          -o -name "*freebsd*" -o -name "*linux-x64*" \
      \) -name "*.node" -delete 2>/dev/null || true; \
    fi; \
    pnpm store prune --force 2>/dev/null || true

# ---------------------------------------------------------------------------
# Minimize attack surface — remove everything not needed at runtime.
# ---------------------------------------------------------------------------

# 1. Prune unselected extension dist and their exclusive node_modules deps.
RUN if [ -f scripts/prune-docker-plugin-dist.mjs ] && [ -f scripts/postinstall-bundled-plugins.mjs ] && [ -f /tmp/openclaw-plugin-selection-supported ]; then \
      OPENCLAW_EXTENSIONS="$(cat /tmp/openclaw-selected-plugin-dirs)" \
      OPENCLAW_BUNDLED_PLUGIN_DIR=extensions \
      node scripts/prune-docker-plugin-dist.mjs && \
      node scripts/postinstall-bundled-plugins.mjs; \
    fi

# 2. Remove ALL extension/package source (only compiled dist/ is needed).
RUN rm -rf extensions/ packages/ patches/

# 3. Strip build tooling, VCS metadata, and dev artifacts.
RUN rm -rf .git .github .gitignore .gitattributes \
           .eslintrc* .prettierrc* .editorconfig \
           tsconfig*.json \
           pnpm-lock.yaml package-lock.json yarn.lock \
           pnpm-workspace.yaml .npmrc openclaw.mjs \
           tests test __tests__ \
           scripts \
           examples \
           ui/src/ \
           CONTRIBUTING.md SECURITY.md CHANGELOG.md \
           /tmp/openclaw-selected-plugin-dirs 2>/dev/null || true

# 4. Remove .d.ts and source maps from dist.
RUN find dist -type f \( -name '*.d.ts' -o -name '*.d.mts' -o -name '*.d.cts' -o -name '*.map' \) -delete 2>/dev/null || true

# ---------------------------------------------------------------------------
# Stage 2a: Runtime — OpenShell-enabled (equivalent of csb/Containerfile)
# Target: --target runtime-openshell
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime-openshell

LABEL name="openclaw-csb" \
      maintainer="Ryan Nix <ryan.nix@gmail.com>" \
      summary="OpenClaw CSB — locked-down agent gateway on Red Hat Hardened Images" \
      description="OpenClaw built from source on Red Hat Hardened Images for Corporate Standard Build" \
      io.k8s.display-name="OpenClaw CSB (Hardened Images)" \
      io.openshift.expose-services="18789:http" \
      io.openshift.tags="ai,agent,nodejs,hardened-images,csb"

USER root

# Red Hat Hardened Images ship a minimal package set; install the same
# tools base/Containerfile installs on ubi-minimal (via microdnf), here via
# dnf. iproute is required by OpenShell's network namespace isolation.
RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
      ca-certificates \
      curl \
      git \
      tar \
      gzip \
      shadow-utils \
      findutils \
      iproute && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# /usr/bin/node ships as a symlink to node-24 in this image. OpenShell's
# per-binary network policy (csb/policy.yaml: binaries: path: /usr/bin/node)
# identifies the calling binary via /proc/<pid>/exe, which the kernel
# resolves to the real underlying file -- replace the symlink with the real
# binary so the policy path matches unambiguously, same guarantee
# csb/Containerfile gets from copying a real Node binary to /usr/bin/node.
RUN rm -f /usr/bin/node && cp -a /usr/bin/node-24 /usr/bin/node

# The Hardened Image bundles the full npm CLI and its vendored dependencies
# (including, at the time of writing, an outdated `tar` with a known CVE --
# see CVE-2026-59873). csb/Containerfile's OpenShell CLI plugin invokes
# `node` and `openshell` directly, never `npm`, so remove it via the
# package manager rather than carry that extra attack surface (same
# rationale as the runtime-openclaw-only target below).
RUN NPM_PKG="$(rpm -qf "$(command -v npm)")" && \
    dnf remove -y "${NPM_PKG}" && \
    dnf clean all

# openshell CLI, required at runtime by the openshell-sandbox plugin (see
# extensions/openshell's own docs: "openshell CLI on PATH"). Installed from
# the static musl release tarball -- zero dynamic dependencies (verified:
# `file` reports "statically linked, stripped"), so it drops in regardless
# of the base image's glibc version.
ARG OPENSHELL_VERSION=0.0.106
RUN set -eux; \
    arch="$(uname -m)"; \
    openshell_base_url="https://github.com/NVIDIA/OpenShell/releases/download/v${OPENSHELL_VERSION}"; \
    openshell_tarball="openshell-${arch}-unknown-linux-musl.tar.gz"; \
    curl -fsSL -o "/tmp/${openshell_tarball}" "${openshell_base_url}/${openshell_tarball}"; \
    curl -fsSL -o /tmp/openshell-checksums-sha256.txt "${openshell_base_url}/openshell-checksums-sha256.txt"; \
    (cd /tmp && grep -E " ${openshell_tarball}\$" openshell-checksums-sha256.txt | sha256sum -c -); \
    tar -xzf "/tmp/${openshell_tarball}" -C /usr/local/bin openshell; \
    chmod 0755 /usr/local/bin/openshell; \
    rm -f "/tmp/${openshell_tarball}" /tmp/openshell-checksums-sha256.txt; \
    openshell --version

# gog CLI (github.com/openclaw/gogcli) — Google Workspace (Gmail, Calendar,
# Drive, Docs, Sheets, ...) from the terminal. Static Go binary, checksum
# verified, same install pattern as the openshell CLI above. Release
# tarballs use Go-style arch names, unlike OpenShell's uname -m names.
ARG GOGCLI_VERSION=0.37.0
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) gogcli_arch=amd64 ;; \
      aarch64) gogcli_arch=arm64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    gogcli_base_url="https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}"; \
    gogcli_tarball="gogcli_${GOGCLI_VERSION}_linux_${gogcli_arch}.tar.gz"; \
    curl -fsSL -o "/tmp/${gogcli_tarball}" "${gogcli_base_url}/${gogcli_tarball}"; \
    curl -fsSL -o /tmp/gogcli-checksums.txt "${gogcli_base_url}/checksums.txt"; \
    (cd /tmp && grep -E " ${gogcli_tarball}\$" gogcli-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${gogcli_tarball}" -C /usr/local/bin ./gog; \
    chmod 0755 /usr/local/bin/gog; \
    rm -f "/tmp/${gogcli_tarball}" /tmp/gogcli-checksums.txt; \
    gog --version

# OpenShell sandbox user/group and ARC sidecar-owned paths. Unlike
# csb/Containerfile, there's no separate base image providing these --
# create them directly here (mirrors base/Containerfile).
RUN groupadd -g 1001 sandbox && \
    useradd -u 1001 -g 0 -G sandbox -m -d /sandbox -s /bin/bash sandbox && \
    mkdir -p \
      /sandbox/.local/bin \
      /sandbox/.venv \
      /sandbox/.config \
      /sandbox/.cache \
      /sandbox/.agents/skills && \
    chown -R 1001:0 /sandbox && \
    chmod -R g=u /sandbox && \
    mkdir -p \
      /etc/openshell/spiffe \
      /etc/openshell/otel \
      /etc/openshell/agents

# Install the repository policy and the root-owned OpenClaw install-policy
# executable. The latter rejects runtime skill and plugin installation.
COPY csb/policy.yaml /etc/openshell/policy.yaml
COPY csb/openclaw-install-policy /usr/local/bin/openclaw-install-policy
COPY csb/openclaw-wrapper /usr/local/bin/openclaw
RUN chmod 0755 /usr/local/bin/openclaw-install-policy /usr/local/bin/openclaw

RUN mkdir -p /app && chmod 0755 /app

COPY --from=builder --chown=0:0 /build /app

COPY --chown=0:0 csb/configure-openclaw.mjs /app/configure-openclaw.mjs
COPY --chown=0:0 csb/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/configure-openclaw.mjs /app/entrypoint.sh && \
    openclaw --version

# The Hardened Image sets HOME=/tmp; override so entrypoint.sh's
# ${HOME}/.openclaw fallback resolves to the useradd-created home dir, not
# the ephemeral /tmp.
ENV HOME=/sandbox \
    OPENCLAW_WORKSPACE_DIR=/sandbox/workspace \
    OPENCLAW_NIX_MODE=1 \
    NODE_ENV=production \
    PATH=/app/node_modules/.bin:$PATH

WORKDIR /app

EXPOSE 18789

USER 1001

ENTRYPOINT ["/app/entrypoint.sh"]

# ---------------------------------------------------------------------------
# Stage 2b: Runtime — OpenClaw only, no OpenShell
# (equivalent of csb/Containerfile.openclaw)
# Target: --target runtime-openclaw-only
# ---------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime-openclaw-only

LABEL name="openclaw-csb-openclaw" \
      maintainer="Ryan Nix <ryan.nix@gmail.com>" \
      summary="OpenClaw CSB — locked-down agent gateway on Red Hat Hardened Images (OpenClaw only, no OpenShell)" \
      description="OpenClaw built from source for Corporate Standard Build, without the OpenShell sandbox integration" \
      io.k8s.display-name="OpenClaw CSB (Hardened Images, OpenClaw-only)" \
      io.openshift.expose-services="18789:http" \
      io.openshift.tags="ai,agent,nodejs,hardened-images,csb"

USER root

# gog CLI — same install pattern as the openshell-enabled target above.
# This base has no system `tar`/`gzip`, so install them via dnf first.
ARG GOGCLI_VERSION=0.37.0
RUN dnf install -y tar gzip && dnf clean all && rm -rf /var/cache/dnf
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
      x86_64) gogcli_arch=amd64 ;; \
      aarch64) gogcli_arch=arm64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    gogcli_base_url="https://github.com/openclaw/gogcli/releases/download/v${GOGCLI_VERSION}"; \
    gogcli_tarball="gogcli_${GOGCLI_VERSION}_linux_${gogcli_arch}.tar.gz"; \
    curl -fsSL -o "/tmp/${gogcli_tarball}" "${gogcli_base_url}/${gogcli_tarball}"; \
    curl -fsSL -o /tmp/gogcli-checksums.txt "${gogcli_base_url}/checksums.txt"; \
    (cd /tmp && grep -E " ${gogcli_tarball}\$" gogcli-checksums.txt | sha256sum -c -); \
    tar -xzf "/tmp/${gogcli_tarball}" -C /usr/local/bin ./gog; \
    chmod 0755 /usr/local/bin/gog; \
    rm -f "/tmp/${gogcli_tarball}" /tmp/gogcli-checksums.txt; \
    gog --version

# The Hardened Image bundles the full npm CLI and its vendored dependencies
# (including, at the time of writing, an outdated `tar` with a known CVE --
# see CVE-2026-59873). The compiled OpenClaw app only invokes `node`
# directly (see csb/openclaw-wrapper) and never shells out to npm at
# runtime, so remove it via the package manager rather than carry that
# extra attack surface.
RUN NPM_PKG="$(rpm -qf "$(command -v npm)")" && \
    dnf remove -y "${NPM_PKG}" && \
    dnf clean all

# Non-root runtime user.
RUN groupadd -g 1001 openclaw && \
    useradd -u 1001 -g 0 -G openclaw -m -d /sandbox -s /bin/bash openclaw && \
    chown -R 1001:0 /sandbox && \
    chmod -R g=u /sandbox

# Install the repository policy and the root-owned OpenClaw install-policy
# executable. The latter rejects runtime skill and plugin installation.
COPY csb/openclaw-install-policy /usr/local/bin/openclaw-install-policy
COPY csb/openclaw-wrapper /usr/local/bin/openclaw
RUN chmod 0755 /usr/local/bin/openclaw-install-policy /usr/local/bin/openclaw

RUN mkdir -p /app && chmod 0755 /app

COPY --from=builder --chown=0:0 /build /app

COPY --chown=0:0 csb/configure-openclaw.mjs /app/configure-openclaw.mjs
COPY --chown=0:0 csb/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/configure-openclaw.mjs /app/entrypoint.sh && \
    openclaw --version

# The Hardened Image sets HOME=/tmp; override so entrypoint.sh's
# ${HOME}/.openclaw fallback resolves to the useradd-created home dir, not
# the ephemeral /tmp.
ENV HOME=/sandbox \
    OPENCLAW_WORKSPACE_DIR=/sandbox/workspace \
    OPENCLAW_NIX_MODE=1 \
    NODE_ENV=production \
    PATH=/app/node_modules/.bin:$PATH

WORKDIR /app

EXPOSE 18789

USER 1001

ENTRYPOINT ["/app/entrypoint.sh"]
