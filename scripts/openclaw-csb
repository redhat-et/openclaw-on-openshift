#!/bin/bash
# Create or recreate the OpenShell CSB sandbox without exposing its Control UI
# token in shell history, repository files, or normal terminal output.

set -euo pipefail

SANDBOX_NAME="${OPENCLAW_CSB_SANDBOX_NAME:-openclaw-csb}"
VOLUME_NAME="openclaw-csb-data"
IMAGE="${OPENCLAW_CSB_IMAGE:-quay.io/redhat-et/openclaw:csb-latest}"
TOKEN_SERVICE="com.redhat-et.openclaw-csb.gateway-token"
TOKEN_ACCOUNT="${USER:-openclaw-csb}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
POLICY_PATH="${REPO_ROOT}/csb/policy.yaml"
FORWARD_RUNTIME_DIR="${TMPDIR:-/tmp}/openclaw-csb-forward-${UID:-user}"
FORWARD_PID_FILE="${FORWARD_RUNTIME_DIR}/${SANDBOX_NAME}.pid"
FORWARD_LOG_FILE="${FORWARD_RUNTIME_DIR}/${SANDBOX_NAME}.log"
FORWARD_CONTROL_SOCKET="/tmp/openclaw-csb-${UID:-user}-${SANDBOX_NAME}.sock"
LEGACY_WIDGET_FORWARD_PID_FILE="${FORWARD_RUNTIME_DIR}/${SANDBOX_NAME}-widget.pid"
WIDGET_PORT="${OPENCLAW_CSB_WIDGET_PORT:-18790}"
gateway_token=""
SKILLS_DIR="${REPO_ROOT}/skills"
DEFAULT_MODEL="${OPENCLAW_CSB_DEFAULT_MODEL:-}"
MODEL_PROVIDERS="${OPENCLAW_CSB_MODEL_PROVIDERS:-}"
INFERENCE_PROVIDER=""
INFERENCE_MODEL=""
declare -a allowed_skills=()
declare -a allowed_plugins=()
declare -a image_skills=()
declare -a providers=()
provider_count=0

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
    COLOR_RESET=$'\033[0m'
    COLOR_BOLD=$'\033[1m'
    COLOR_BLUE=$'\033[34m'
    COLOR_GREEN=$'\033[32m'
    COLOR_RED=$'\033[31m'
else
    COLOR_RESET=""
    COLOR_BOLD=""
    COLOR_BLUE=""
    COLOR_GREEN=""
    COLOR_RED=""
fi

usage() {
    cat <<'EOF'
Usage: ./scripts/openclaw-csb <command> [options]

Commands:
  quickstart  Create the sandbox, upload skills, start OpenClaw, and forward the UI.
  create      Create the OpenShell sandbox, reusing its host-keyring token.
  gateway start    Start the OpenClaw gateway and wait for it to become healthy.
  gateway stop     Stop the OpenClaw gateway without stopping the sandbox or UI forward.
  gateway restart  Restart the OpenClaw gateway and wait for it to become healthy.
  gateway status   Report whether the OpenClaw gateway is healthy.
  token-copy  Copy the stored Control UI token to the system clipboard.

Options:
  --skills-dir <dir>    Skill directory for quickstart (default: ./skills).
  --with <option>       Apply a repository-owned optional provider helper.
                        Available: anthropic-api-key, google-workspace,
                        openai-api-key, gemini.
  --allow-skill <name>  Restrict visible workspace skills (repeatable).
  --allow-plugin <name> Enable a plugin by ID (repeatable). Plugins are
                        disabled by default; this is the only way to turn one on.
  --image-skill <name>  Copy an image-owned skill into the persistent workspace.
  --provider <name>     Attach an OpenShell provider (repeatable; default: none).
  --default-model <ref> Select the initial provider/model reference.
  --inference-provider <name>
                        Configure the workspace inference.local route provider.
  --inference-model <id>
                        Configure the workspace inference.local route model.
  --model-providers <json>
                        Supply non-secret OpenClaw model provider configuration.

Optional model environment:
  OPENCLAW_CSB_DEFAULT_MODEL selects the initial provider/model reference.
  OPENCLAW_CSB_MODEL_PROVIDERS supplies non-secret custom provider JSON.
EOF
}

die() {
    printf '%sERROR:%s %s\n' "${COLOR_RED}" "${COLOR_RESET}" "$*" >&2
    exit 1
}

heading() {
    printf '\n%s%s==>%s %s\n' "${COLOR_BOLD}" "${COLOR_BLUE}" "${COLOR_RESET}" "$*"
}

success() {
    printf '%s✓%s %s\n' "${COLOR_GREEN}" "${COLOR_RESET}" "$*"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "'$1' is required"
}

validate_widget_port() {
    [[ "${WIDGET_PORT}" =~ ^[0-9]+$ ]] \
        || die "OPENCLAW_CSB_WIDGET_PORT must be a numeric TCP port"
    (( 10#${WIDGET_PORT} >= 1 && 10#${WIDGET_PORT} <= 65535 )) \
        || die "OPENCLAW_CSB_WIDGET_PORT must be between 1 and 65535"
    [[ "${WIDGET_PORT}" != "18789" ]] \
        || die "OPENCLAW_CSB_WIDGET_PORT must differ from the Control UI port 18789"
}

require_secret_store() {
    case "$(uname -s)" in
        Darwin)
            require_command security
            ;;
        Linux)
            require_command secret-tool
            ;;
        *)
            die "this helper supports macOS Keychain and Linux Secret Service only"
            ;;
    esac
}

require_clipboard() {
    case "$(uname -s)" in
        Darwin)
            require_command pbcopy
            ;;
        Linux)
            command -v wl-copy >/dev/null 2>&1 || command -v xclip >/dev/null 2>&1 \
                || die "'wl-copy' or 'xclip' is required to copy the token"
            ;;
    esac
}

read_stored_token() {
    case "$(uname -s)" in
        Darwin)
            security find-generic-password \
                -s "${TOKEN_SERVICE}" \
                -a "${TOKEN_ACCOUNT}" \
                -w 2>/dev/null
            ;;
        Linux)
            secret-tool lookup \
                service "${TOKEN_SERVICE}" \
                account "${TOKEN_ACCOUNT}" 2>/dev/null
            ;;
    esac
}

write_stored_token() {
    case "$(uname -s)" in
        Darwin)
            security add-generic-password \
                -U \
                -s "${TOKEN_SERVICE}" \
                -a "${TOKEN_ACCOUNT}" \
                -w "$1" >/dev/null
            ;;
        Linux)
            printf '%s' "$1" | secret-tool store \
                --label="OpenClaw CSB gateway token" \
                service "${TOKEN_SERVICE}" \
                account "${TOKEN_ACCOUNT}" >/dev/null
            ;;
    esac
}

copy_to_clipboard() {
    case "$(uname -s)" in
        Darwin)
            pbcopy
            ;;
        Linux)
            if command -v wl-copy >/dev/null 2>&1; then
                wl-copy
            else
                xclip -selection clipboard
            fi
            ;;
    esac
}

allowed_skills_json() {
    local skill
    local delimiter=""

    printf '['
    for skill in "${allowed_skills[@]}"; do
        printf '%s"%s"' "${delimiter}" "${skill}"
        delimiter=","
    done
    printf ']'
}

allowed_plugins_json() {
    local plugin
    local delimiter=""

    printf '['
    for plugin in "${allowed_plugins[@]}"; do
        printf '%s"%s"' "${delimiter}" "${plugin}"
        delimiter=","
    done
    printf ']'
}

read_volume_token() {
    podman run --rm \
        --entrypoint node \
        -v "${VOLUME_NAME}:/data:ro" \
        "${IMAGE}" \
        -e 'const fs=require("fs"); const config=JSON.parse(fs.readFileSync("/data/.openclaw/openclaw.json","utf8")); const token=config?.gateway?.auth?.token; if(typeof token!=="string"||token.length===0) process.exit(1); process.stdout.write(token);' \
        2>/dev/null
}

load_existing_token() {
    if gateway_token="$(read_stored_token)" && [[ -n "${gateway_token}" ]]; then
        return
    fi

    if podman volume inspect "${VOLUME_NAME}" >/dev/null 2>&1 \
        && gateway_token="$(read_volume_token)" \
        && [[ -n "${gateway_token}" ]]; then
        write_stored_token "${gateway_token}"
        echo "Migrated the existing Control UI token into the host keyring."
        return
    fi

    die "no stored Control UI token; run './scripts/openclaw-csb create' first"
}

ensure_network() {
    if podman network inspect openshell >/dev/null 2>&1; then
        return
    fi

    podman network create openshell >/dev/null
}

ensure_volume() {
    if podman volume inspect "${VOLUME_NAME}" >/dev/null 2>&1; then
        return
    fi

    podman volume create "${VOLUME_NAME}" >/dev/null
    podman run --rm \
        --user 0 \
        --entrypoint /bin/sh \
        -v "${VOLUME_NAME}:/data" \
        "${IMAGE}" \
        -c 'chmod 0777 /data'
}

configure_inference() {
    if [[ -z "${INFERENCE_PROVIDER}" && -z "${INFERENCE_MODEL}" ]]; then
        return
    fi
    [[ -n "${INFERENCE_PROVIDER}" && -n "${INFERENCE_MODEL}" ]] \
        || die "--inference-provider and --inference-model must be used together"

    heading "Configuring OpenShell inference.local"
    openshell inference set \
        --provider "${INFERENCE_PROVIDER}" \
        --model "${INFERENCE_MODEL}"
    success "inference.local routes to ${INFERENCE_PROVIDER}/${INFERENCE_MODEL}"
}

load_or_create_token() {
    if gateway_token="$(read_stored_token)" && [[ -n "${gateway_token}" ]]; then
        return
    fi

    if gateway_token="$(read_volume_token)" && [[ -n "${gateway_token}" ]]; then
        write_stored_token "${gateway_token}"
        echo "Migrated the existing Control UI token into the host keyring."
        return
    fi

    gateway_token="$(openssl rand -hex 32)"
    write_stored_token "${gateway_token}"
    printf '%s' "${gateway_token}" | copy_to_clipboard
    echo "Created a Control UI token in the host keyring and copied it to the clipboard."
}

create() {
    local -a create_args
    local index

    configure_inference

    if openshell sandbox get "${SANDBOX_NAME}" >/dev/null 2>&1; then
        success "Reusing existing sandbox: ${SANDBOX_NAME}"
        return
    fi

    heading "Creating sandbox"
    ensure_network
    ensure_volume
    load_or_create_token

    create_args=(
        sandbox create
        --name "${SANDBOX_NAME}"
        --from "${IMAGE}"
        --cpu 2
        --memory 4Gi
        --policy "${POLICY_PATH}"
        --driver-config-json '{"podman":{"mounts":[{"type":"volume","source":"openclaw-csb-data","target":"/sandbox/persist","read_only":false}]}}'
        --env "OPENCLAW_GATEWAY_TOKEN=${gateway_token}"
        --env OPENCLAW_STATE_DIR=/sandbox/persist/.openclaw
        --env OPENCLAW_WORKSPACE_DIR=/sandbox/persist/workspace
        --env "OPENCLAW_WIDGET_PORT=${WIDGET_PORT}"
    )
    for (( index=0; index<provider_count; index++ )); do
        create_args+=(--provider "${providers[$index]}")
    done
    if [[ -n "${DEFAULT_MODEL}" ]]; then
        create_args+=(--env "OPENCLAW_DEFAULT_MODEL=${DEFAULT_MODEL}")
    fi
    if [[ -n "${MODEL_PROVIDERS}" ]]; then
        create_args+=(--env "OPENCLAW_PROVIDERS=${MODEL_PROVIDERS}")
    fi
    if (( ${#allowed_skills[@]} > 0 )); then
        create_args+=(--env "OPENCLAW_ALLOWED_SKILLS=$(allowed_skills_json)")
    fi
    if (( ${#allowed_plugins[@]} > 0 )); then
        create_args+=(--env "OPENCLAW_ALLOWED_PLUGINS=$(allowed_plugins_json)")
    fi
    create_args+=(-- /bin/true)

    openshell "${create_args[@]}"
}

upload_skills() {
    local candidate
    local found_skill=0

    [[ -d "${SKILLS_DIR}" ]] || die "skills directory '${SKILLS_DIR}' does not exist"
    heading "Uploading skills from ${SKILLS_DIR}"
    openshell sandbox exec -n "${SANDBOX_NAME}" -- \
        mkdir -p /sandbox/persist/workspace/skills

    if [[ -f "${SKILLS_DIR}/SKILL.md" ]]; then
        upload_skill "${SKILLS_DIR}"
        return
    fi

    for candidate in "${SKILLS_DIR}"/*; do
        [[ -d "${candidate}" && -f "${candidate}/SKILL.md" ]] || continue
        upload_skill "${candidate}"
        found_skill=1
    done

    (( found_skill == 1 )) || die "no immediate skill directories with SKILL.md in '${SKILLS_DIR}'"
}

upload_skill() {
    local skill_dir="$1"
    local skill_dir_name

    skill_dir_name="$(basename "${skill_dir}")"
    [[ "${skill_dir_name}" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
        || die "invalid skill directory '${skill_dir_name}'"
    openshell sandbox exec -n "${SANDBOX_NAME}" -- \
        rm -rf "/sandbox/persist/workspace/skills/${skill_dir_name}"
    openshell sandbox upload "${SANDBOX_NAME}" "${skill_dir}" \
        /sandbox/persist/workspace/skills
}

install_image_skills() {
    local skill_name

    (( ${#image_skills[@]} > 0 )) || return 0
    for skill_name in "${image_skills[@]}"; do
        openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
            test -f "/app/skills/${skill_name}/SKILL.md" \
            || die "image skill '${skill_name}' does not exist"
        openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
            rm -rf "/sandbox/persist/workspace/skills/${skill_name}"
        openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
            cp -R "/app/skills/${skill_name}" /sandbox/persist/workspace/skills
    done
}

gateway_is_healthy() {
    openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
        curl -fsS http://127.0.0.1:18789/healthz >/dev/null 2>&1
}

wait_for_gateway() {
    local attempt=1
    local max_attempts=60

    until gateway_is_healthy; do
        if (( attempt >= max_attempts )); then
            die "Gateway did not become healthy after ${max_attempts} health checks."
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
}

resolve_widget_port_from_sandbox() {
    local configured_widget_port

    configured_widget_port="$(
        openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
            node -e '
                const fs = require("node:fs");
                const stateDir = process.env.OPENCLAW_STATE_DIR || "/sandbox/persist/.openclaw";
                const configPath = process.env.OPENCLAW_CONFIG_PATH || `${stateDir}/openclaw.json`;
                const config = JSON.parse(fs.readFileSync(configPath, "utf8"));
                const port = config?.mcp?.apps?.sandboxPort;
                if (Number.isInteger(port)) process.stdout.write(String(port));
            ' 2>/dev/null
    )" || return 0

    [[ -n "${configured_widget_port}" ]] || return 0
    WIDGET_PORT="${configured_widget_port}"
    validate_widget_port
}

start_gateway() {
    if gateway_is_healthy; then
        success "OpenClaw gateway is already healthy."
        return
    fi

    heading "Starting OpenClaw gateway"
    openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
        /bin/sh -c 'nohup /app/entrypoint.sh >/tmp/openclaw-gateway.log 2>&1 </dev/null &'
    wait_for_gateway
    success "OpenClaw gateway is healthy at http://localhost:18789"
}

stop_gateway() {
    local attempt=1
    local max_attempts=30

    heading "Stopping OpenClaw gateway"
    if ! openshell sandbox exec -n "${SANDBOX_NAME}" --no-tty -- \
        /bin/sh -c '
            found=1
            for process_dir in /proc/[0-9]*; do
                command_line=$(tr "\000" " " < "${process_dir}/cmdline" 2>/dev/null) || continue
                case "${command_line}" in
                    "node /app/dist/index.js gateway "*)
                        kill -TERM "${process_dir##*/}"
                        found=0
                        ;;
                esac
            done
            exit "${found}"
        ' >/dev/null 2>&1; then
        success "OpenClaw gateway is already stopped."
        return
    fi

    while gateway_is_healthy; do
        if (( attempt >= max_attempts )); then
            die "Gateway did not stop after ${max_attempts} health checks."
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    success "OpenClaw gateway stopped."
}

ensure_forward() {
    local attempt=1
    local forward_command=""
    local max_attempts=60
    local forward_pid=""
    local gateway_name
    local openshell_executable
    local proxy_command
    local workspace_name="${OPENCLAW_CSB_OPENSHELL_WORKSPACE:-${OPENSHELL_WORKSPACE:-default}}"

    mkdir -p "${FORWARD_RUNTIME_DIR}"
    if [[ -r "${FORWARD_PID_FILE}" ]]; then
        read -r forward_pid < "${FORWARD_PID_FILE}"
    fi

    if [[ "${forward_pid}" =~ ^[0-9]+$ ]] \
        && kill -0 "${forward_pid}" >/dev/null 2>&1; then
        forward_command="$(ps -p "${forward_pid}" -o command= 2>/dev/null || true)"
        if [[ "${forward_command}" == *"openshell forward service ${SANDBOX_NAME}"* ]]; then
            kill "${forward_pid}" >/dev/null 2>&1 || true
            forward_pid=""
        fi
    fi
    rm -f "${FORWARD_PID_FILE}"

    if [[ -r "${LEGACY_WIDGET_FORWARD_PID_FILE}" ]]; then
        local legacy_widget_pid=""
        read -r legacy_widget_pid < "${LEGACY_WIDGET_FORWARD_PID_FILE}"
        if [[ "${legacy_widget_pid}" =~ ^[0-9]+$ ]] \
            && kill -0 "${legacy_widget_pid}" >/dev/null 2>&1; then
            forward_command="$(ps -p "${legacy_widget_pid}" -o command= 2>/dev/null || true)"
            if [[ "${forward_command}" == *"openshell forward service ${SANDBOX_NAME}"* ]]; then
                kill "${legacy_widget_pid}" >/dev/null 2>&1 || true
            fi
        fi
        rm -f "${LEGACY_WIDGET_FORWARD_PID_FILE}"
    fi

    if [[ ! -S "${FORWARD_CONTROL_SOCKET}" ]] \
        || ! ssh -S "${FORWARD_CONTROL_SOCKET}" -O check sandbox >/dev/null 2>&1; then
        rm -f "${FORWARD_CONTROL_SOCKET}"
        gateway_name="${OPENCLAW_CSB_OPENSHELL_GATEWAY:-${OPENSHELL_GATEWAY:-}}"
        if [[ -z "${gateway_name}" ]]; then
            gateway_name="$(openshell status 2>/dev/null \
                | awk -F': ' '$1 ~ /^[[:space:]]*Gateway$/ { print $2; exit }')"
        fi
        [[ "${gateway_name}" =~ ^[[:alnum:]_.-]+$ ]] \
            || die "could not determine a safe active OpenShell gateway name"
        [[ "${workspace_name}" =~ ^[[:alnum:]_.-]+$ ]] \
            || die "invalid OpenShell workspace name '${workspace_name}'"
        [[ "${SANDBOX_NAME}" =~ ^[[:alnum:]_.-]+$ ]] \
            || die "invalid sandbox name '${SANDBOX_NAME}'"

        openshell_executable="$(command -v openshell)"
        [[ "${openshell_executable}" =~ ^/[[:alnum:]_./-]+$ ]] \
            || die "OpenShell executable path cannot be used safely by ssh"
        proxy_command="${openshell_executable} ssh-proxy --gateway-name ${gateway_name} --name ${SANDBOX_NAME} --workspace ${workspace_name}"

        ssh -f -N -M -S "${FORWARD_CONTROL_SOCKET}" \
            -o "ProxyCommand=${proxy_command}" \
            -o ExitOnForwardFailure=yes \
            -o StrictHostKeyChecking=no \
            -o UserKnownHostsFile=/dev/null \
            -o GlobalKnownHostsFile=/dev/null \
            -o LogLevel=ERROR \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=3 \
            -L 127.0.0.1:18789:127.0.0.1:18789 \
            -L "127.0.0.1:${WIDGET_PORT}:127.0.0.1:${WIDGET_PORT}" \
            sandbox \
            >"${FORWARD_LOG_FILE}" 2>&1 </dev/null
    fi

    attempt=1
    until curl -fsS http://127.0.0.1:18789/healthz >/dev/null 2>&1; do
        if (( attempt >= max_attempts )); then
            tail -n 20 "${FORWARD_LOG_FILE}" >&2 || true
            die "Control UI forward did not become healthy after ${max_attempts} checks."
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
}

quickstart() {
    heading "OpenClaw CSB Quickstart"
    create
    upload_skills
    install_image_skills
    start_gateway
    resolve_widget_port_from_sandbox
    ensure_forward
    success "OpenClaw is ready at http://localhost:18789"
    printf '  Native widgets use the loopback sandbox forward at http://127.0.0.1:%s.\n' \
        "${WIDGET_PORT}"
    printf '  If this is your first time accessing this sandbox, run %s%s token-copy%s before opening the UI.\n' \
        "${COLOR_BOLD}" "$0" "${COLOR_RESET}"
}

copy_token() {
    load_existing_token
    printf '%s' "${gateway_token}" | copy_to_clipboard
    success "Copied the Control UI token to the clipboard."
}

gateway_command() {
    local action="${1:-}"

    [[ $# -eq 1 ]] || die "usage: './scripts/openclaw-csb gateway start|stop|restart|status'"
    openshell sandbox get "${SANDBOX_NAME}" >/dev/null 2>&1 \
        || die "sandbox '${SANDBOX_NAME}' does not exist"

    case "${action}" in
        start)
            start_gateway
            ;;
        stop)
            stop_gateway
            ;;
        restart)
            stop_gateway
            start_gateway
            ;;
        status)
            if gateway_is_healthy; then
                success "OpenClaw gateway is healthy at http://localhost:18789"
            else
                die "OpenClaw gateway is not healthy"
            fi
            ;;
        *)
            die "usage: './scripts/openclaw-csb gateway start|stop|restart|status'"
            ;;
    esac
}

trap 'unset gateway_token' EXIT

parse_options() {
    while (( $# > 0 )); do
        case "$1" in
            --skills-dir)
                [[ -n "${2:-}" ]] || die "--skills-dir requires a directory"
                SKILLS_DIR="$2"
                shift 2
                ;;
            --with)
                local option_name="${2:-}"
                local option_script
                local -a option_args=()
                [[ "${option_name}" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "invalid provider option '${option_name}'"
                option_script="${SCRIPT_DIR}/options/${option_name}"
                [[ -x "${option_script}" ]] \
                    || die "unknown provider option '${option_name}'"
                while IFS= read -r option_arg; do
                    [[ -n "${option_arg}" ]] && option_args+=("${option_arg}")
                done < <("${option_script}" quickstart-args)
                parse_options "${option_args[@]}"
                shift 2
                ;;
            --allow-skill)
                [[ -n "${2:-}" ]] || die "--allow-skill requires a skill name"
                [[ "$2" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "invalid skill name '$2'"
                allowed_skills+=("$2")
                shift 2
                ;;
            --allow-plugin)
                [[ -n "${2:-}" ]] || die "--allow-plugin requires a plugin ID"
                [[ "$2" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "invalid plugin ID '$2'"
                allowed_plugins+=("$2")
                shift 2
                ;;
            --image-skill)
                [[ -n "${2:-}" ]] || die "--image-skill requires a skill name"
                [[ "$2" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "invalid image skill name '$2'"
                image_skills+=("$2")
                shift 2
                ;;
            --provider)
                [[ -n "${2:-}" ]] || die "--provider requires a provider name"
                [[ "$2" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "invalid provider name '$2'"
                providers[provider_count]="$2"
                provider_count=$((provider_count + 1))
                shift 2
                ;;
            --default-model)
                [[ -n "${2:-}" ]] || die "--default-model requires a model reference"
                DEFAULT_MODEL="$2"
                shift 2
                ;;
            --inference-provider)
                [[ "${2:-}" =~ ^[[:alnum:]][[:alnum:]._-]*$ ]] \
                    || die "--inference-provider requires a provider name"
                INFERENCE_PROVIDER="$2"
                shift 2
                ;;
            --inference-model)
                [[ -n "${2:-}" ]] || die "--inference-model requires a model ID"
                INFERENCE_MODEL="$2"
                shift 2
                ;;
            --model-providers)
                [[ -n "${2:-}" ]] || die "--model-providers requires JSON"
                MODEL_PROVIDERS="$2"
                shift 2
                ;;
            *)
                die "unknown option '$1'"
                ;;
        esac
    done
}

command="${1:-}"
shift || true

case "${command}" in
    quickstart|create)
        parse_options "$@"
        validate_widget_port
        require_secret_store
        require_clipboard
        require_command podman
        require_command openshell
        require_command openssl
        [[ "${command}" != "quickstart" ]] || require_command ssh
        ;;
    gateway)
        require_command openshell
        ;;
    token-copy)
        require_secret_store
        require_clipboard
        ;;
esac

case "${command}" in
    quickstart)
        quickstart
        ;;
    create)
        create
        ;;
    gateway)
        gateway_command "$@"
        ;;
    token-copy)
        copy_token
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 1
        ;;
esac
