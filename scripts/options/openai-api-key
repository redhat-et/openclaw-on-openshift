#!/bin/bash
set -euo pipefail

[[ "${1:-}" == "quickstart-args" ]] || {
    echo "Usage: $0 quickstart-args" >&2
    exit 2
}

printf '%s\n' \
    --inference-provider \
    "${OPENCLAW_CSB_OPENAI_PROVIDER_NAME:-openai}" \
    --inference-model \
    gpt-5.6-sol \
    --model-providers \
    '{"openai":{"api":"openai-responses","baseUrl":"https://inference.local/v1","apiKey":"unused","models":[{"id":"gpt-5.6-sol","name":"GPT-5.6 Sol"}]}}' \
    --allow-plugin \
    openai \
    --allow-plugin \
    codex \
    --default-model \
    openai/gpt-5.6-sol
