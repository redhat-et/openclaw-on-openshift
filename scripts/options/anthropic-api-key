#!/bin/bash
set -euo pipefail

[[ "${1:-}" == "quickstart-args" ]] || {
    echo "Usage: $0 quickstart-args" >&2
    exit 2
}

printf '%s\n' \
    --provider \
    "${OPENCLAW_CSB_ANTHROPIC_PROVIDER_NAME:-anthropic}" \
    --allow-plugin \
    anthropic \
    --default-model \
    anthropic/claude-opus-4-8
